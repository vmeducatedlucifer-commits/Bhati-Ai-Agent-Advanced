# Rawal AI configuration template
# Copy to backend/.env for local use. Never commit backend/.env.

# ---- application ------------------------------------------------------------
ENV=dev
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins, or * only for trusted local development.
CORS_ORIGINS=*

# ---- authentication and signing --------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=72
# Empty means open local mode. Set a strong value for any public deployment.
AUTH_PASSWORD=
AUTH_USERNAME=rawal
# Keep false unless the instance is intentionally anonymous and private.
ALLOW_ANONYMOUS=false

# ---- persistence ------------------------------------------------------------
DATA_DIR=./data
WORKSPACE_ROOT=./data/workspaces
# Optional async SQL URL. Empty uses SQLite at DATA_DIR/bhati.db for compatibility.
DATABASE_URL=
# MONGO_URI and MONGODB_URI are accepted aliases; MongoDB is recommended on Render.
MONGO_URI=
MONGODB_URI=
DATABASE_NAME=rawal_ai
MONGODB_DB_NAME=
# Optional Google Drive workspace archive credentials (raw or base64 JSON).
GDRIVE_CREDENTIALS_JSON=
GDRIVE_FOLDER_ID=

# ---- default model ----------------------------------------------------------
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=600
MAX_AGENT_STEPS=80
MAX_CONTEXT_TOKENS=160000
COMPACT_AT_RATIO=0.75
# Loopback-only embedded gateway used by the production start script.
GATEWAY_URL=http://127.0.0.1:8081/v1
GATEWAY_SHARED_SECRET=

# ---- sandbox ----------------------------------------------------------------
# auto = Docker when reachable, otherwise path-confined local execution.
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=rawal-ai-sandbox:latest
SANDBOX_FALLBACK_IMAGE=python:3.12-slim
SANDBOX_CPUS=1.0
SANDBOX_MEMORY_MB=2048
SANDBOX_IDLE_TIMEOUT_S=1800
SANDBOX_NETWORK=bridge
SANDBOX_COMMAND_TIMEOUT_S=300
SUPERSERVE_API_KEY=
SUPERSERVE_API_URL=https://api.superserve.ai
SUPERSERVE_TEMPLATE=superserve/base
SUPERSERVE_POOL_SIZE=5
# Optional remote Chromium over CDP. Set this on Render to keep browser RAM off
# the API container; leave empty to use local Playwright Chromium.
BROWSER_CDP_URL=
BROWSER_MAX_SESSIONS=1
BROWSER_IDLE_TIMEOUT_S=900

# ---- integrations -----------------------------------------------------------
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
VERCEL_TOKEN=
RENDER_TOKEN=
HF_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ---- web search -------------------------------------------------------------
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---- email transcript sharing -----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
